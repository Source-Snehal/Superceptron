# Superceptron Cloudflare Worker — secrets
# Set each with: wrangler secret put <KEY_NAME>
# Never commit real values to git.

# Anthropic (already set)
ANTHROPIC_API_KEY=

# Stripe — get from dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe webhook signing secret — get from dashboard.stripe.com/webhooks
# Webhook URL: https://superceptron-chat.superceptron.workers.dev/stripe-webhook
# Event to enable: checkout.session.completed
STRIPE_WEBHOOK_SECRET=
