{
  "functions": { "api/**/*.js": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/api/portal/roles/:id/uploads/:uid", "destination": "/api/portal/roles/[id]/uploads/[uid]" },
    { "source": "/api/portal/roles/:id/submit",       "destination": "/api/portal/roles/[id]/submit" },
    { "source": "/api/portal/roles/:id/upload",       "destination": "/api/portal/roles/[id]/upload" },
    { "source": "/api/portal/roles/:id/download",     "destination": "/api/portal/roles/[id]/download" },
    { "source": "/api/portal/roles/:id",              "destination": "/api/portal/roles/[id]" },
    { "source": "/api/portal/admin/roles/:id/actions","destination": "/api/portal/admin/roles/[id]/actions" },
    { "source": "/api/portal/admin/roles/:id/deliver","destination": "/api/portal/admin/roles/[id]/deliver" },
    { "source": "/api/portal/admin/roles/:id",        "destination": "/api/portal/admin/roles/[id]" }
  ]
}
